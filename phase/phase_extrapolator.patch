+@dataclass
+class LocalFit:
+    window: int
+    degree: int
+    span: float             # time scale used to normalize the window (s)
+    coeffs: np.ndarray      # coefficients in u = (t - t_end) / span, increasing order
+    cond: float             # condition number of the scaled design matrix
+    resid_std: float        # residual std of the fit (nan if no dof left)
+    cov: Optional[np.ndarray]  # coefficient covariance (None if no dof left)
+
+    def value(self, dt_ahead: float) -> float:
+        return float(np.polynomial.polynomial.polyval(dt_ahead / self.span, self.coeffs))
+
+    def derivative(self, k: int) -> float:
+        if k > self.degree:
+            return 0.0
+        return factorial(k) * float(self.coeffs[k]) / self.span ** k
+
+    def derivative_se(self, k: int) -> float:
+        if k > self.degree or self.cov is None:
+            return float("nan")
+        return factorial(k) * float(np.sqrt(max(self.cov[k, k], 0.0))) / self.span ** k
+
+
+def fit_local_poly(t: np.ndarray, x: np.ndarray, degree: int) -> LocalFit:
+    """Least-squares polynomial fit in centered, scaled time u = (t - t[-1]) / span."""
+    span = float(t[-1] - t[0])
+    u = (t - t[-1]) / span                       # u in [-1, 0]
+    V = np.vander(u, degree + 1, increasing=True)
+    coeffs, *_ = np.linalg.lstsq(V, x, rcond=None)
+    dof = len(t) - (degree + 1)
+    resid_std, cov = float("nan"), None
+    if dof > 0:
+        resid = x - V @ coeffs
+        resid_std = float(np.sqrt(resid @ resid / dof))
+        cov = resid_std ** 2 * np.linalg.pinv(V.T @ V)
+    return LocalFit(len(t), degree, span, coeffs, float(np.linalg.cond(V)), resid_std, cov)
+
+
+def _derivative_entry(f: LocalFit, k: int) -> Dict:
+    """Derivative k at t_now. 'resolved' needs degree >= k and std_err < half the value
+    (an assumed 2-sigma rule). std_err covers noise only, not model bias."""
+    if k > f.degree:
+        return {"value": None, "std_err": None, "resolved": False,
+                "note": f"model degree {f.degree} < {k}"}
+    v, se = f.derivative(k), f.derivative_se(k)
+    return {"value": v, "std_err": se, "resolved": bool(np.isfinite(se) and se < 0.5 * abs(v))}
+
+
+def validate_series(t, x) -> Tuple[np.ndarray, np.ndarray]:
+    t = np.asarray(t, dtype=float)
+    x = np.asarray(x, dtype=float)
+    if t.ndim != 1 or x.ndim != 1:
+        raise ValueError("t and x must be 1-D arrays")
+    if len(t) != len(x):
+        raise ValueError(f"t and x lengths differ ({len(t)} vs {len(x)})")
+    if len(t) < MIN_SAMPLES:
+        raise ValueError(f"need at least {MIN_SAMPLES} samples, got {len(t)}")
+    if not (np.all(np.isfinite(t)) and np.all(np.isfinite(x))):
+        raise ValueError("t and x must be finite (no NaN/inf)")
+    if np.any(np.diff(t) <= 0):
+        raise ValueError("t must be strictly increasing")
+    return t, x
+
+
+def sampling_report(t: np.ndarray) -> Dict:
+    d = np.diff(t)
+    med = float(np.median(d))
+    spread = float((d.max() - d.min()) / med)
+    return {
+        "n_samples": int(len(t)),
+        "duration_s": float(t[-1] - t[0]),
+        "median_dt_s": med,
+        "fps_from_data": 1.0 / med,
+        "uneven_sampling": bool(spread > UNEVEN_TOL),
+        "dt_relative_spread": spread,
+        "gaps_over_1p5x_median": int(np.sum(d > 1.5 * med)),
+    }
 
 
