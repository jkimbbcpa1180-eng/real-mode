+# Published saturated escaping beta power for PURE Ni-63, per emitting face
+# (Monte Carlo, Belghachi et al. arXiv:1903.09098). Used as a cross-check only.
+PUBLISHED_NI63_SATURATION_UW_CM2 = 3.28
+
