+    if temp_k >= tbl[-1][0]:
+        # linear extrapolation off the last segment
+        (t0, h0), (t1, h1) = tbl[-2], tbl[-1]
+        return h1 + (h1 - h0) * (temp_k - t1) / (t1 - t0)
+    for (t0, h0), (t1, h1) in zip(tbl, tbl[1:]):
+        if t0 <= temp_k <= t1:
+            return h0 + (h1 - h0) * (temp_k - t0) / (t1 - t0)
+    return tbl[-1][1]
